    "@splidejs/svelte-splide": "^0.2.9",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/enhanced-img": "^0.3.0",
    "@sveltejs/kit": "^2.59.0",
